  "keyFeatures": [
    "Detects jailbroken (iOS) and rooted (Android) devices",
    "Identifies mock/fake GPS location spoofing",
    "Granular Android rooted detection via RootBeer integration",
    "Hook detection for suspicious installed applications",
    "Checks for external storage (SD card) on Android",
    "ADB enabled detection on Android",
    "Debug mode detection (async) on both platforms",
    "React Native New Architecture (TurboModules) support"
